{
  "name": "FreelancerJob",
  "type": "object",
  "properties": {
    "freelancer_id": {
      "type": "string",
      "title": "Freelancer",
      "ref": "Freelancer"
    },
    "task_description": {
      "type": "string",
      "title": "Task Description"
    },
    "order_id": {
      "type": "string",
      "title": "For Order",
      "ref": "Order"
    },
    "cost": {
      "type": "number",
      "title": "Cost"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "title": "Due Date"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "Commissioned",
        "In Progress",
        "Delivered",
        "Paid"
      ],
      "default": "Commissioned"
    }
  },
  "required": [
    "freelancer_id",
    "task_description"
  ]
}