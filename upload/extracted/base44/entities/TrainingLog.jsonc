{
  "name": "TrainingLog",
  "type": "object",
  "properties": {
    "trainee_id": {
      "type": "string",
      "title": "Trainee",
      "ref": "Trainee"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Date"
    },
    "skill_area": {
      "type": "string",
      "title": "Skill / Topic Taught"
    },
    "notes": {
      "type": "string",
      "title": "Trainer Notes",
      "description": "What was taught or observed \u2014 filled in by the trainer",
      "format": "textarea"
    },
    "trainee_reflection": {
      "type": "string",
      "title": "Trainee Reflection",
      "description": "In the trainee's own words \u2014 filled in by the trainee themselves",
      "format": "textarea"
    },
    "skill_level": {
      "type": "string",
      "title": "Skill Level at This Session",
      "enum": [
        "Beginner",
        "Practicing",
        "Confident"
      ],
      "default": "Practicing"
    }
  },
  "required": [
    "trainee_id",
    "date"
  ]
}