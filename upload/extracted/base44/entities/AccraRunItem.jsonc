{
  "name": "AccraRunItem",
  "type": "object",
  "properties": {
    "trip_id": {
      "type": "string",
      "title": "Trip",
      "ref": "AccraRunTrip"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "planned_before": {
      "type": "boolean",
      "title": "Planned Before Trip",
      "default": true
    },
    "obtained": {
      "type": "boolean",
      "title": "Obtained",
      "default": false
    },
    "planned_cost": {
      "type": "number",
      "title": "Planned Cost"
    },
    "actual_cost": {
      "type": "number",
      "title": "Actual Cost"
    },
    "order_id": {
      "type": "string",
      "title": "For Order",
      "ref": "Order"
    },
    "supplier_id": {
      "type": "string",
      "title": "Supplier",
      "ref": "Supplier"
    },
    "entry_log": {
      "type": "string",
      "title": "Entry Source",
      "description": "How this record got into the app",
      "enum": [
        "Self-Entered",
        "Apprentice-Logged",
        "Assisted Call",
        "Assisted WhatsApp"
      ],
      "default": "Self-Entered"
    },
    "logged_by": {
      "type": "string",
      "title": "Logged By",
      "description": "Who entered this record (staff name or 'Sewsiness Assisted')"
    },
    "assisted_call_id": {
      "type": "string",
      "title": "Assisted Call",
      "ref": "AssistedCallLog"
    }
  },
  "required": [
    "trip_id",
    "description"
  ]
}