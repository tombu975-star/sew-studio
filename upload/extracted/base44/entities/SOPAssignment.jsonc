{
  "name": "SOPAssignment",
  "type": "object",
  "properties": {
    "sop_id": {
      "type": "string",
      "title": "SOP",
      "ref": "SOP"
    },
    "sop_version": {
      "type": "number",
      "title": "SOP Version Used"
    },
    "sop_title_snapshot": {
      "type": "string",
      "title": "SOP Title (at assignment)"
    },
    "checklist_snapshot": {
      "type": "array",
      "title": "Checklist (at assignment)",
      "items": {
        "type": "string"
      }
    },
    "assigned_to": {
      "type": "string",
      "title": "Assigned To",
      "ref": "User"
    },
    "assigned_by": {
      "type": "string",
      "title": "Assigned By",
      "ref": "User"
    },
    "role_context": {
      "type": "string",
      "title": "Role Context",
      "enum": [
        "Madam",
        "Staff",
        "Trainee",
        "Trainer"
      ]
    },
    "order_id": {
      "type": "string",
      "title": "Related Order",
      "ref": "Order"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "title": "Due Date"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "Assigned",
        "Started",
        "Completed",
        "Evidence Submitted",
        "Reviewed",
        "Compliant",
        "Incomplete",
        "Exception",
        "Escalated",
        "Returned",
        "Reassigned",
        "Archived"
      ],
      "default": "Assigned"
    },
    "checklist_progress": {
      "type": "array",
      "title": "Checklist Progress",
      "items": {
        "type": "object",
        "properties": {
          "item": {
            "type": "string"
          },
          "checked": {
            "type": "boolean"
          }
        }
      }
    },
    "notes": {
      "type": "string",
      "title": "Notes",
      "format": "textarea"
    },
    "evidence_urls": {
      "type": "array",
      "title": "Evidence Files",
      "items": {
        "type": "string",
        "format": "url"
      }
    },
    "started_date": {
      "type": "string",
      "format": "date",
      "title": "Started Date"
    },
    "completed_date": {
      "type": "string",
      "format": "date",
      "title": "Completed Date"
    },
    "reviewed_by": {
      "type": "string",
      "title": "Reviewed By",
      "ref": "User"
    },
    "reviewed_date": {
      "type": "string",
      "format": "date",
      "title": "Reviewed Date"
    },
    "review_notes": {
      "type": "string",
      "title": "Review Notes",
      "format": "textarea"
    }
  },
  "required": [
    "sop_id",
    "assigned_to"
  ]
}