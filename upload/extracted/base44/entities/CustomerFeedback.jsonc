{
  "name": "CustomerFeedback",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string",
      "title": "Customer",
      "ref": "Customer"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Date"
    },
    "rating": {
      "type": "number",
      "title": "Satisfaction Rating (1-5)"
    },
    "type": {
      "type": "string",
      "title": "Type",
      "enum": [
        "Compliment",
        "Complaint",
        "General"
      ],
      "default": "General"
    },
    "feedback": {
      "type": "string",
      "title": "Feedback",
      "format": "textarea"
    },
    "resolution": {
      "type": "string",
      "title": "Resolution",
      "format": "textarea"
    },
    "resolution_date": {
      "type": "string",
      "format": "date",
      "title": "Resolution Date"
    },
    "staff_responsible": {
      "type": "string",
      "title": "Staff Responsible",
      "ref": "User"
    },
    "follow_up_required": {
      "type": "boolean",
      "title": "Follow-Up Required",
      "default": false
    }
  },
  "required": [
    "customer_id",
    "date"
  ]
}