{
  "name": "Quote",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string",
      "title": "Customer",
      "ref": "Customer"
    },
    "customer_name": {
      "type": "string",
      "title": "Client Name",
      "description": "Used when the enquiry is not yet a saved customer"
    },
    "garment_type": {
      "type": "string",
      "title": "Garment Type",
      "enum": [
        "Bridal Gown",
        "Evening Dress",
        "Traditional Set (Kente/Ntoma)",
        "Wedding Guest Outfit",
        "Men's Agbada / Suit",
        "Two-Piece / Jumpsuit",
        "Ready-to-Wear Piece",
        "Accessories (Headpiece/Sash)"
      ],
      "default": "Evening Dress"
    },
    "description": {
      "type": "string",
      "title": "Description",
      "format": "textarea"
    },
    "fabric_cost": {
      "type": "number",
      "title": "Fabric Cost"
    },
    "complexity": {
      "type": "string",
      "title": "Complexity",
      "enum": [
        "Simple",
        "Moderate",
        "Elaborate"
      ],
      "default": "Moderate"
    },
    "urgency": {
      "type": "string",
      "title": "Urgency",
      "enum": [
        "Normal",
        "Rush"
      ],
      "default": "Normal"
    },
    "suggested_price": {
      "type": "number",
      "title": "Suggested Price"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "Draft",
        "Sent",
        "Accepted",
        "Declined",
        "Converted"
      ],
      "default": "Draft"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Date"
    },
    "converted_order_id": {
      "type": "string",
      "title": "Converted Order",
      "ref": "Order"
    }
  },
  "required": [
    "garment_type",
    "date"
  ]
}