{
  "name": "OrderLabour",
  "type": "object",
  "properties": {
    "order_id": {
      "type": "string",
      "title": "Order",
      "ref": "Order"
    },
    "task_description": {
      "type": "string",
      "title": "Task Description"
    },
    "staff_id": {
      "type": "string",
      "title": "Staff Member",
      "ref": "User"
    },
    "hours": {
      "type": "number",
      "title": "Hours"
    },
    "rate": {
      "type": "number",
      "title": "Rate"
    },
    "cost": {
      "type": "number",
      "title": "Cost"
    },
    "entry_log": {
      "type": "string",
      "title": "Entry Source",
      "description": "How this record got into the app",
      "enum": [
        "Self-Entered",
        "Apprentice-Logged",
        "Assisted Call",
        "Assisted WhatsApp"
      ],
      "default": "Self-Entered"
    },
    "logged_by": {
      "type": "string",
      "title": "Logged By",
      "description": "Who entered this record (staff name or 'Sewsiness Assisted')"
    },
    "assisted_call_id": {
      "type": "string",
      "title": "Assisted Call",
      "ref": "AssistedCallLog"
    }
  },
  "required": [
    "order_id",
    "task_description"
  ]
}