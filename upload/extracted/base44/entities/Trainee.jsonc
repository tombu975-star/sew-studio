{
  "name": "Trainee",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Full Name"
    },
    "program": {
      "type": "string",
      "title": "Program",
      "enum": [
        "Apprenticeship",
        "Master Class Attendee"
      ],
      "default": "Apprenticeship"
    },
    "phone": {
      "type": "string",
      "title": "Phone"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "title": "Start Date"
    },
    "trainer_id": {
      "type": "string",
      "title": "Trainer / Teacher",
      "ref": "User"
    },
    "stage": {
      "type": "string",
      "title": "Current Stage",
      "enum": [
        "Foundation",
        "Intermediate",
        "Advanced"
      ],
      "default": "Foundation"
    },
    "notes": {
      "type": "string",
      "title": "Notes",
      "format": "textarea"
    }
  },
  "required": [
    "name"
  ]
}