{
  "name": "CustomerDocument",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string",
      "title": "Customer",
      "ref": "Customer"
    },
    "name": {
      "type": "string",
      "title": "Document Name"
    },
    "category": {
      "type": "string",
      "title": "Category",
      "enum": [
        "Contract",
        "Invoice",
        "Receipt",
        "Agreement",
        "Design Approval",
        "Measurement Sheet",
        "Customer Form",
        "Other"
      ]
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Date"
    },
    "uploaded_by": {
      "type": "string",
      "title": "Uploaded By",
      "ref": "User"
    },
    "order_id": {
      "type": "string",
      "title": "Related Order",
      "ref": "Order"
    },
    "file_url": {
      "type": "string",
      "format": "url",
      "title": "File"
    },
    "notes": {
      "type": "string",
      "title": "Notes",
      "format": "textarea"
    }
  },
  "required": [
    "customer_id",
    "name",
    "file_url"
  ]
}