{
  "name": "Course",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Skill Module"
    },
    "description": {
      "type": "string",
      "title": "Description",
      "format": "textarea"
    },
    "sequence": {
      "type": "number",
      "title": "Order",
      "description": "Lower numbers appear first in the curriculum"
    },
    "videos": {
      "type": "array",
      "title": "Training Videos",
      "description": "Video lessons that make up this module",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "title": "Video Title"
          },
          "url": {
            "type": "string",
            "format": "url",
            "title": "Video URL"
          },
          "quiz": {
            "type": "array",
            "title": "Quiz Questions",
            "description": "Simple multiple-choice questions to check understanding after this video",
            "items": {
              "type": "object",
              "properties": {
                "question": {
                  "type": "string",
                  "title": "Question"
                },
                "options": {
                  "type": "array",
                  "title": "Options",
                  "items": {
                    "type": "string"
                  }
                },
                "correct_index": {
                  "type": "number",
                  "title": "Correct Option Index"
                }
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "name"
  ]
}