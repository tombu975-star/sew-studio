{
  "name": "CustomerGalleryItem",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string",
      "title": "Customer",
      "ref": "Customer"
    },
    "title": {
      "type": "string",
      "title": "Title"
    },
    "description": {
      "type": "string",
      "title": "Description",
      "format": "textarea"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Date"
    },
    "uploaded_by": {
      "type": "string",
      "title": "Uploaded By",
      "ref": "User"
    },
    "category": {
      "type": "string",
      "title": "Category",
      "enum": [
        "Inspiration",
        "Previous Outfit",
        "Approved Design",
        "Sketch",
        "Fabric Photo",
        "Colour Reference",
        "Fitting Photo",
        "Final Outfit"
      ]
    },
    "approval_status": {
      "type": "string",
      "title": "Approval Status",
      "enum": [
        "Reference",
        "Proposed",
        "Approved",
        "Rejected",
        "Final"
      ],
      "default": "Reference"
    },
    "image_url": {
      "type": "string",
      "format": "url",
      "title": "Image"
    }
  },
  "required": [
    "customer_id",
    "image_url"
  ]
}