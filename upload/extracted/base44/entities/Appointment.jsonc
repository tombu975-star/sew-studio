{
  "name": "Appointment",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string",
      "title": "Customer",
      "ref": "Customer"
    },
    "type": {
      "type": "string",
      "title": "Appointment Type",
      "enum": [
        "Consultation",
        "Measurement",
        "Design Review",
        "Fabric Selection",
        "First Fitting",
        "Second Fitting",
        "Final Fitting",
        "Collection",
        "Other"
      ]
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Date"
    },
    "time": {
      "type": "string",
      "title": "Time"
    },
    "staff_id": {
      "type": "string",
      "title": "Staff Member",
      "ref": "User"
    },
    "location": {
      "type": "string",
      "title": "Location"
    },
    "purpose": {
      "type": "string",
      "title": "Purpose",
      "format": "textarea"
    },
    "notes": {
      "type": "string",
      "title": "Notes",
      "format": "textarea"
    },
    "attendance": {
      "type": "string",
      "title": "Attendance",
      "enum": [
        "Scheduled",
        "Attended",
        "Cancelled",
        "Rescheduled",
        "No-show"
      ],
      "default": "Scheduled"
    },
    "order_id": {
      "type": "string",
      "title": "Related Order",
      "ref": "Order"
    }
  },
  "required": [
    "customer_id",
    "type",
    "date"
  ]
}