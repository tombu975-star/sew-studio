{
  "name": "MeasurementSet",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string",
      "title": "Customer",
      "ref": "Customer"
    },
    "set_name": {
      "type": "string",
      "title": "Measurement Set Name"
    },
    "date_taken": {
      "type": "string",
      "format": "date",
      "title": "Date Taken"
    },
    "taken_by": {
      "type": "string",
      "title": "Taken By",
      "ref": "User"
    },
    "unit": {
      "type": "string",
      "title": "Unit",
      "enum": [
        "Inches",
        "Centimetres"
      ],
      "default": "Inches"
    },
    "garment_type": {
      "type": "string",
      "title": "Garment Type",
      "enum": [
        "General",
        "Dress",
        "Top",
        "Skirt",
        "Trousers",
        "Bridal"
      ],
      "default": "General"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "Draft",
        "Confirmed"
      ],
      "default": "Draft"
    },
    "customer_approval": {
      "type": "string",
      "title": "Customer Approval",
      "enum": [
        "Pending",
        "Approved"
      ],
      "default": "Pending"
    },
