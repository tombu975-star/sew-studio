{
  "name": "CommunicationLog",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string",
      "title": "Customer",
      "ref": "Customer"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Date"
    },
    "time": {
      "type": "string",
      "title": "Time"
    },
    "type": {
      "type": "string",
      "title": "Type",
      "enum": [
        "Call",
        "WhatsApp",
        "Email",
        "Message",
        "Other"
      ]
    },
    "staff_id": {
      "type": "string",
      "title": "Staff Member",
      "ref": "User"
    },
    "summary": {
      "type": "string",
      "title": "Summary",
      "format": "textarea"
    },
    "attachment_url": {
      "type": "string",
      "format": "url",
      "title": "Attachment"
    },
    "follow_up_required": {
      "type": "boolean",
      "title": "Follow-Up Required",
      "default": false
    },
    "follow_up_date": {
      "type": "string",
      "format": "date",
      "title": "Follow-Up Date"
    }
  },
  "required": [
    "customer_id",
    "date",
    "type",
    "summary"
  ]
}