{
  "name": "Settings",
  "type": "object",
  "properties": {
    "overhead_amount": {
      "type": "number",
      "title": "Overhead Per Order"
    },
    "outstanding_threshold": {
      "type": "number",
      "title": "Outstanding Alert Threshold"
    },
    "self_payout": {
      "type": "number",
      "title": "Amount Paid To Yourself"
    },
    "typical_load": {
      "type": "number",
      "title": "Typical Active Work Per Staff",
      "description": "Open tasks + active orders one person can comfortably carry; powers the workload signal in Business Health"
    },
    "margin_target": {
      "type": "number",
      "title": "Healthy Margin Target Per Order",
      "description": "Average margin per active order that counts as healthy in the Business Health score"
    },
    "owner_gender": {
      "type": "string",
      "title": "Owner Title",
      "description": "Controls whether the owner role is shown as 'Madam' or 'Master' across the app",
      "enum": [
        "Madam",
        "Master"
      ],
      "default": "Madam"
    }
  }
}