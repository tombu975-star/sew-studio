{
  "name": "HealthSnapshot",
  "type": "object",
  "properties": {
    "month": {
      "type": "string",
      "title": "Month",
      "description": "Month key in YYYY-MM format"
    },
    "score": {
      "type": "number",
      "title": "Health Score"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "On Track",
        "Needs Attention",
        "At Risk"
      ]
    }
  },
  "required": [
    "month"
  ]
}