{
  "name": "Order",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string",
      "title": "Customer",
      "ref": "Customer"
    },
    "garment_design": {
      "type": "string",
      "title": "Garment / Design",
      "format": "textarea"
    },
    "design_image": {
      "type": "string",
      "title": "Design Image",
      "format": "url"
    },
    "order_date": {
      "type": "string",
      "format": "date",
      "title": "Order Date"
    },
    "delivery_date": {
      "type": "string",
      "format": "date",
      "title": "Delivery Date"
    },
    "measurement_id": {
      "type": "string",
      "title": "Measurement Used",
      "ref": "Measurement"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "Enquiry",
        "Quoted",
        "Consultation",
        "Confirmed",
        "Deposit Paid",
        "In Production",
        "Fitting",
        "Alterations",
        "Ready",
        "Collected/Delivered",
        "Completed"
      ],
      "default": "Enquiry"
    },
    "assigned_staff_id": {
      "type": "string",
      "title": "Assigned Staff",
      "ref": "User"
    },
    "selling_price": {
      "type": "number",
      "title": "Selling Price"
    },
    "notes": {
      "type": "string",
      "title": "Notes",
      "format": "textarea"
    },
    "entry_log": {
      "type": "string",
      "title": "Entry Source",
      "description": "How this record got into the app",
      "enum": [
        "Self-Entered",
        "Apprentice-Logged",
        "Assisted Call",
        "Assisted WhatsApp"
      ],
      "default": "Self-Entered"
    },
    "logged_by": {
      "type": "string",
      "title": "Logged By",
      "description": "Who entered this record (staff name or 'Sewsiness Assisted')"
    },
    "assisted_call_id": {
      "type": "string",
      "title": "Assisted Call",
      "ref": "AssistedCallLog"
    }
  },
  "required": [
    "customer_id",
    "order_date",
    "status"
  ]
}