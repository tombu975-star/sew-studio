{
  "name": "MonthlyPlan",
  "type": "object",
  "properties": {
    "month": {
      "type": "string",
      "title": "Month",
      "description": "Month key in YYYY-MM format"
    },
    "occasion": {
      "type": "string",
      "title": "Occasion / Season",
      "description": "e.g. Wedding season, Homowo, Christmas, Rainy season"
    },
    "events": {
      "type": "array",
      "title": "Events & Festivals",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string",
      "title": "Notes",
      "format": "textarea"
    },
    "target_revenue": {
      "type": "number",
      "title": "Target Revenue"
    }
  },
  "required": [
    "month"
  ]
}