{
  "name": "Customer",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Full Name"
    },
    "first_name": {
      "type": "string",
      "title": "First Name"
    },
    "middle_name": {
      "type": "string",
      "title": "Middle Name"
    },
    "last_name": {
      "type": "string",
      "title": "Last Name"
    },
    "preferred_name": {
      "type": "string",
      "title": "Preferred Name"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "Active",
        "Inactive"
      ],
      "default": "Active"
    },
    "customer_type": {
      "type": "array",
      "title": "Customer Type(s)",
      "items": {
        "type": "string",
        "enum": [
          "New Customer",
          "Returning Customer",
          "VIP",
          "Bridal",
          "Regular Wear",
          "Occasion Wear",
          "Corporate",
          "Wholesale",
          "Other"
        ]
      }
    },
    "tags": {
      "type": "array",
      "title": "Tags",
      "items": {
        "type": "string"
      }
    },
    "customer_since": {
      "type": "string",
      "format": "date",
      "title": "Customer Since"
    },
    "preferred_contact_method": {
      "type": "string",
      "title": "Preferred Contact Method",
      "enum": [
        "Phone",
        "WhatsApp",
        "Email"
      ]
    },
    "dob": {
      "type": "string",
      "format": "date",
      "title": "Date of Birth"
    },
    "gender": {
      "type": "string",
      "title": "Gender"
    },
    "occupation": {
      "type": "string",
      "title": "Occupation"
    },
    "company": {
      "type": "string",
      "title": "Company / Organisation"
    },
    "phone": {
      "type": "string",
      "title": "Primary Phone"
    },
    "alternative_phone": {
      "type": "string",
      "title": "Alternative Phone"
    },
    "whatsapp": {
      "type": "string",
      "title": "WhatsApp Number"
    },
    "email": {
      "type": "string",
      "format": "email",
      "title": "Email"
    },
    "secondary_email": {
      "type": "string",
      "format": "email",
      "title": "Secondary Email"
    },
    "address_line1": {
      "type": "string",
      "title": "Address Line 1"
    },
    "address_line2": {
      "type": "string",
      "title": "Address Line 2"
    },
    "city": {
      "type": "string",
      "title": "City"
    },
    "region": {
      "type": "string",
      "title": "Region / State"
    },
    "country": {
      "type": "string",
      "title": "Country"
    },
    "postcode": {
      "type": "string",
      "title": "Postcode"
    },
    "delivery_address": {
      "type": "string",
      "title": "Delivery Address",
      "format": "textarea"
    },
    "billing_address": {
      "type": "string",
      "title": "Billing Address",
      "format": "textarea"
    },
    "alt_contact_name": {
      "type": "string",
      "title": "Alternative Contact Name"
    },
    "alt_contact_relationship": {
      "type": "string",
      "title": "Alternative Contact Relationship"
    },
    "alt_contact_phone": {
      "type": "string",
      "title": "Alternative Contact Phone"
    },
    "alt_contact_email": {
      "type": "string",
      "title": "Alternative Contact Email"
    },
    "entry_source": {
      "type": "string",
      "title": "Customer Source",
      "description": "How this client found the studio",
      "enum": [
        "Instagram",
        "Facebook",
        "TikTok",
        "WhatsApp",
        "Website",
        "Referral",
        "Walk-in",
        "Event",
        "Repeat Client",
        "Saw Our Work",
        "Other"
      ]
    },
    "referred_by": {
      "type": "string",
      "title": "Referred By"
    },
    "referral_notes": {
      "type": "string",
      "title": "Referral Notes",
      "format": "textarea"
    },
    "preferred_communication_time": {
      "type": "string",
      "title": "Preferred Communication Time"
    },
    "customer_likes": {
      "type": "string",
      "title": "Customer Likes",
      "format": "textarea"
    },
    "customer_dislikes": {
      "type": "string",
      "title": "Customer Dislikes",
      "format": "textarea"
    },
    "special_instructions": {
      "type": "string",
      "title": "Special Instructions",
      "format": "textarea"
    },
    "relationship_notes": {
      "type": "string",
      "title": "Important Relationship Notes",
      "format": "textarea"
    },
    "skin_tone": {
      "type": "string",
      "title": "Skin Tone",
      "enum": [
        "Fair",
        "Light",
        "Medium",
        "Tan",
        "Deep",
        "Dark"
      ]
    },
    "undertone": {
      "type": "string",
      "title": "Undertone",
      "enum": [
        "Warm",
        "Cool",
        "Neutral"
      ]
    },
    "height": {
      "type": "number",
      "title": "Height (cm)"
    },
    "weight": {
      "type": "number",
      "title": "Weight (kg)"
    },
    "shoe_size": {
      "type": "string",
      "title": "Shoe Size"
    },
    "preferred_styles": {
      "type": "array",
      "title": "Preferred Styles",
      "items": {
        "type": "string",
        "enum": [
          "Classic",
          "Modern",
          "Minimal",
          "Dramatic",
          "Elegant",
          "Traditional",
          "Trendy",
          "Modest",
          "Custom"
        ]
      }
    },
    "favourite_colours": {
      "type": "string",
      "title": "Favourite Colours"
    },
    "colours_to_avoid": {
      "type": "string",
      "title": "Colours to Avoid"
    },
    "favourite_fabrics": {
      "type": "string",
      "title": "Favourite Fabrics"
    },
    "fabrics_to_avoid": {
      "type": "string",
      "title": "Fabrics to Avoid"
    },
    "design_preferences": {
      "type": "string",
      "title": "Design Preferences",
      "format": "textarea",
      "description": "Neckline, sleeves, silhouette, skirt shape, waist placement, embellishment, beading, appliqu\u00e9, print\u2026"
    },
    "style_notes": {
      "type": "string",
      "title": "Style Notes",
      "format": "textarea"
    },
    "preferred_fit": {
      "type": "string",
      "title": "Preferred Fit",
      "enum": [
        "Bodycon",
        "Very Fitted",
        "Fitted",
        "Semi-Fitted",
        "Regular",
        "Relaxed",
        "Oversized"
      ]
    },
    "fit_characteristics": {
      "type": "array",
      "title": "Fit / Body Characteristics",
      "items": {
        "type": "string",
        "enum": [
          "Balanced",
          "Defined Waist",
          "Fuller Bust",
          "Fuller Hip",
          "Curvier Lower Body",
          "Curvier Upper Body",
          "Straight Proportion",
          "Other"
        ]
      }
    },
    "designer_fit_observation": {
      "type": "string",
      "title": "Designer Fit Observation",
      "format": "textarea"
    },
    "loyalty_points": {
      "type": "number",
      "title": "Loyalty Points",
      "default": 0
    },
    "notes": {
      "type": "string",
      "title": "Notes",
      "format": "textarea"
    },
    "portal_token": {
      "type": "string",
      "title": "Portal Token",
      "description": "Secret token for this client's portal link"
    }
  },
  "required": [
    "name"
  ]
}