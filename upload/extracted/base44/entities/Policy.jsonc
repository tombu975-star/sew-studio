{
  "name": "Policy",
  "type": "object",
  "properties": {
    "deposit_percent": {
      "type": "number",
      "title": "Deposit Required",
      "description": "Percentage of the price required before production starts",
      "default": 50
    },
    "rush_fee_percent": {
      "type": "number",
      "title": "Rush Fee",
      "description": "Percentage added to the price for rush orders",
      "default": 25
    },
    "quote_valid_days": {
      "type": "number",
      "title": "Quote Validity (days)",
      "description": "How long a quoted price holds",
      "default": 14
    },
    "free_fittings": {
      "type": "number",
      "title": "Fittings Included",
      "description": "Fittings included in the order price",
      "default": 2
    },
    "alterations_window_days": {
      "type": "number",
      "title": "Alterations Window (days)",
      "description": "Days after delivery to bring the garment back for adjustments",
      "default": 14
    },
    "balance_before_pickup": {
      "type": "boolean",
      "title": "Full Balance Before Pickup",
      "description": "Garment is only released once fully paid",
      "default": true
    },
    "deposit_policy": {
      "type": "string",
      "title": "Deposit Policy",
      "format": "textarea",
      "description": "In your words \u2014 shown to clients on their portal"
    },
    "cancellation_policy": {
      "type": "string",
      "title": "Cancellation Policy",
      "format": "textarea",
      "description": "In your words \u2014 shown to clients on their portal"
    }
  },
  "required": []
}