{
  "name": "SOPException",
  "type": "object",
  "properties": {
    "assignment_id": {
      "type": "string",
      "title": "Assignment",
      "ref": "SOPAssignment"
    },
    "sop_id": {
      "type": "string",
      "title": "SOP",
      "ref": "SOP"
    },
    "order_id": {
      "type": "string",
      "title": "Related Order",
      "ref": "Order"
    },
    "reported_by": {
      "type": "string",
      "title": "Reported By",
      "ref": "User"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Date"
    },
    "category": {
      "type": "string",
      "title": "Category",
      "enum": [
        "Human Error",
        "Missing Information",
        "Resource Shortage",
        "Material Shortage",
        "Customer-Related Issue",
        "Equipment Problem",
        "Staff Absence",
        "Training / Skill Gap",
        "Process Problem",
        "Other"
      ]
    },
    "description": {
      "type": "string",
      "title": "Description",
      "format": "textarea"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "Open",
        "Escalated",
        "Resolved"
      ],
      "default": "Open"
    },
    "resolution": {
      "type": "string",
      "title": "Resolution",
      "format": "textarea"
    },
    "resolved_date": {
      "type": "string",
      "format": "date",
      "title": "Resolved Date"
    }
  },
  "required": [
    "sop_id",
    "date",
    "category",
    "description"
  ]
}