// Madam Studio — Multi-tenant atelier management schema
// Each "shop" is a tenant (an atelier). All data is scoped by shopId.
// Local dev uses SQLite; for Supabase deployment, change provider to "postgresql"
// and set DATABASE_URL to your Supabase pooler connection string. See DEPLOYMENT.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // LOCAL DEV: "sqlite". SUPABASE DEPLOY: change to "postgresql".
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Tenant ────────────────────────────────────────────────────────
model Shop {
  id        String   @id @default(cuid())
  name      String   // "Madam Studio"
  slug      String   @unique // URL-friendly identifier, e.g. "madam-studio"
  plan      String   @default("trial") // trial | pro | enterprise
  currency  String   @default("GHS")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  customers       Customer[]
  orders          Order[]
  tasks           Task[]
  measurements    MeasurementSet[]
  styleConcepts   StyleConcept[]
  feedback        CustomerFeedback[]
  settings        Settings[]
  freelancers     Freelancer[]
  communityPosts  CommunityPost[]
  trainingLogs    TrainingLog[]
  certificates    Certificate[]
  customerNotifications CustomerNotification[]
}

// ─── People ────────────────────────────────────────────────────────
model User {
  id        String   @id @default(cuid())
  email     String   @unique // globally unique — one account per email
  fullName  String
  role      String   @default("staff") // madam | staff | trainer | trainee
  gender    String?  // Male | Female | Other (drives Madam/Master label)
  phone     String?
  password  String?  // demo-only plaintext; real apps must hash
  // Tenant
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  // Trainee profile (school-portal style) — set by trainer/owner
  mentorId           String?
  mentor             User?    @relation("TraineeMentor", fields: [mentorId], references: [id])
  trainees           User[]   @relation("TraineeMentor")
  trainingDurationWeeks Int?
  trainingStartedAt  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ordersAssigned Order[]   @relation("OrderStaff")
  tasks          Task[]
  measurements   MeasurementSet[]
  trainingAsTrainee TrainingLog[] @relation("TraineeLogs")
  trainingAsMentor  TrainingLog[] @relation("MentorLogs")
  certificatesAsTrainee Certificate[] @relation("TraineeCerts")
  certificatesAsIssuer Certificate[] @relation("IssuerCerts")
  gradedTasks   Task[]   @relation("TaskGrader")
}

model Freelancer {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name      String
  specialty String?
  skills    String?
  phone     String?
  email     String?
  rate      Float?
  status    String   @default("Available")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Clients ───────────────────────────────────────────────────────
model Customer {
  id            String   @id @default(cuid())
  shopId        String
  shop          Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name          String
  phone         String?
  email         String?
  whatsapp      String?
  gender        String?
  occupation    String?
  city          String?
  country       String?
  entrySource   String?
  referredBy    String?
  customerType  String?
  preferredStyles String?
  favouriteColours String?
  coloursToAvoid String?
  favouriteFabrics String?
  preferredFit  String?
  designPreferences String?
  styleNotes    String?
  skinTone      String?
  height        Float?
  weight        Float?
  loyaltyPoints Int      @default(0)
  notes         String?
  status        String   @default("Active")
  portalToken   String?  @unique // secret token for the customer's order-tracking portal
  portalPhone   String?  // last 4 of phone used to verify portal access (optional extra check)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders         Order[]
  measurements   MeasurementSet[]
  styleConcepts  StyleConcept[]
  feedback       CustomerFeedback[]
  notifications  CustomerNotification[]
}

model MeasurementSet {
  id         String   @id @default(cuid())
  shopId     String
  shop       Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  staffId    String?
  staff      User?    @relation(fields: [staffId], references: [id])
  unit       String   @default("cm")
  dateTaken  DateTime @default(now())
  bust       Float?
  waist      Float?
  hip        Float?
  shoulder   Float?
  length     Float?
  sleeve     Float?
  inseam     Float?
  neck       Float?
  notes      String?
  createdAt  DateTime @default(now())
}

model CustomerFeedback {
  id         String   @id @default(cuid())
  shopId     String
  shop       Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rating     Int      @default(5)
  type       String   @default("General")
  feedback   String?
  date       DateTime @default(now())
}

// ─── Orders & production ───────────────────────────────────────────
model Order {
  id             String   @id @default(cuid())
  shopId         String
  shop           Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id])
  garmentDesign  String
  designImage    String?
  orderDate      DateTime
  deliveryDate   DateTime?
  status         String   @default("Enquiry")
  assignedStaffId String?
  assignedStaff   User?   @relation("OrderStaff", fields: [assignedStaffId], references: [id])
  sellingPrice    Float   @default(0)
  fabricCost      Float   @default(0)
  labourCost      Float   @default(0)
  notes           String?
  priority        String  @default("Medium")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  payments   Payment[]
  fittings   Fitting[]
  tasks      Task[]
  notifications CustomerNotification[]
}

model Payment {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount    Float
  method    String?
  date      DateTime @default(now())
  note      String?
  createdAt DateTime @default(now())
}

model Fitting {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  date      DateTime
  status    String   @default("Scheduled")
  notes     String?
  createdAt DateTime @default(now())
}

model Task {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  title     String
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  staffId   String?
  staff     User?    @relation(fields: [staffId], references: [id])
  status    String   @default("To Do")
  priority  String   @default("Medium")
  dueDate   DateTime?
  notes     String?
  maxScore  Int?
  score     Int?
  gradedById String?
  gradedBy  User?    @relation("TaskGrader", fields: [gradedById], references: [id])
  gradedAt  DateTime?
  feedback  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Style assist ──────────────────────────────────────────────────
model StyleConcept {
  id            String   @id @default(cuid())
  shopId        String
  shop          Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  garmentType   String
  occasion      String?
  desiredLook   String?
  season        String?
  budget        Float?
  colourPreference String?
  conceptName   String
  silhouette    String?
  neckline      String?
  sleeveStyle   String?
  length        String?
  fabric        String?
  colour        String?
  detailing     String?
  embellishment String?
  whyThisMayWork String?
  fitConsiderations String?
  matchPercent  Int?
  designDirection String?
  imageUrl      String?
  status        String   @default("Suggested")
  rejectionReason String?
  dataConfidence String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─── Settings ──────────────────────────────────────────────────────
model Settings {
  id            String   @id @default(cuid())
  shopId        String   @unique
  shop          Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  ownerGender   String   @default("Madam")
  studioName    String   @default("Madam Studio")
  overheadAmount Float   @default(0)
  selfPayout    Float    @default(0)
  currency      String   @default("GHS")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─── Community ─────────────────────────────────────────────────────
model CommunityPost {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  authorId  String?
  authorName String
  authorRole String?
  type      String   @default("update")
  title     String?
  body      String
  imageUrl  String?
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments  CommunityComment[]
  likes     CommunityLike[]
}

model CommunityComment {
  id        String   @id @default(cuid())
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorName String
  authorId  String?
  body      String
  createdAt DateTime @default(now())
}

model CommunityLike {
  id        String   @id @default(cuid())
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String?
  createdAt DateTime @default(now())

  @@unique([postId, authorId])
}

// ─── Training & certificates ───────────────────────────────────────
model TrainingLog {
  id          String   @id @default(cuid())
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  traineeId   String
  trainee     User     @relation("TraineeLogs", fields: [traineeId], references: [id], onDelete: Cascade)
  mentorId    String?
  mentor      User?    @relation("MentorLogs", fields: [mentorId], references: [id])
  skill       String?
  title       String
  note        String?
  status      String   @default("Learning")
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Certificate {
  id              String   @id @default(cuid())
  shopId          String
  shop            Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  traineeId       String
  trainee         User     @relation("TraineeCerts", fields: [traineeId], references: [id], onDelete: Cascade)
  issuedById      String
  issuedBy        User     @relation("IssuerCerts", fields: [issuedById], references: [id])
  programName     String   @default("Atelier Apprenticeship Programme")
  durationWeeks   Int      @default(12)
  skillsAchieved  String
  honors          String?
  certificateNo   String   @unique
  issuedAt        DateTime @default(now())
  createdAt       DateTime @default(now())
}

// ─── Customer notifications (order alerts) ────────────────────────
model CustomerNotification {
  id          String   @id @default(cuid())
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderId     String?
  order       Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type        String   // status_change | payment_received | fitting_scheduled | fitting_completed | message | ready_for_collection | delivered
  title       String
  body        String
  statusFrom  String?  // previous status (for status_change)
  statusTo    String?  // new status (for status_change)
  readAt      DateTime?
  // Message delivery (auto-sent to the customer's preferred channel)
  direction   String   @default("auto") // auto | manual
  channel     String   @default("in_app") // whatsapp | sms | email | in_app
  recipient   String?  // phone/email the message was sent to
  deliveryStatus String @default("sent") // sent | delivered | failed
  sentAt      DateTime @default(now())
  createdAt   DateTime @default(now())
}
